[IO-handlers]
# $key templates declare asset families, resolved on demand by Simulation.link
assets = out/$uid, w, simsio.serializers.JSONSerializer
aux = out/$uid/$key, w, simsio.serializers.NPZSerializer
dat = data/$uid/$key, w, simsio.serializers.PickleSerializer
log = out/$uid,  , simsio.serializers.LogSerializer
par = out/$uid, w, simsio.serializers.YAMLSerializer
res = out/$uid, w, simsio.serializers.NPZSerializer

[configs]
directory = configs
header_tag = ===
header_ref = <<<
uuid_regex = [a-z0-9]{32}
template = false
unsafe_update = true

[versioning]
git_revision = git rev-parse HEAD

[logging-format]
format = %(asctime)s %(levelname)-8s | %(message)s
datefmt = %Y-%m-%d %H:%M

[logging-levels]
root = INFO
simsio = INFO
simsio.iocore = WARNING
